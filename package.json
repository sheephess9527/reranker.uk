{
  "name": "reranker.uk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "check:links": "node scripts/check-links.mjs",
    "check:zh": "node scripts/check-zh-coverage.mjs",
    "check:i18n": "node scripts/check-i18n-gaps.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "check:ld": "node scripts/check-structured-data.mjs",
    "check:external": "node scripts/check-external-links.mjs",
    "measure:latency": "node scripts/measure-demo-latency.mjs",
    "check": "npm run build && npm run check:links && npm run check:ld",
    "test": "playwright test tests/demo.smoke.spec.js tests/a11y.spec.js tests/feed.spec.js",
    "test:a11y": "playwright test tests/a11y.spec.js",
    "test:real": "playwright test tests/demo.smoke.real.spec.js",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "node-html-parser": "^9.0.1"
  }
}
